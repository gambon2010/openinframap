#!/usr/bin/env python3
"""Stands in for uv: logs the call; `uv run --project ... python ARGS` (the scripts'
own Python, lib/python.sh) runs ARGS in the scripts' real environment
(FAKE_UV_PYTHON), as the scripts need its answers; anything else (extra data, the
Wikidata cache) only succeeds."""

import json
import os
import sys

args = sys.argv[1:]
with open(os.environ["FAKE_LOG"], "a") as log:
    log.write(json.dumps(["uv", *args]) + "\n")
if args[:1] == ["run"] and "--project" in args and "python" in args:
    python = os.environ["FAKE_UV_PYTHON"]
    os.execv(python, [python, *args[args.index("python") + 1 :]])
