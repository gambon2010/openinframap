#!/usr/bin/env python3
"""Stands in for uv: logs the call; `uv run --project ... python -I SCRIPT ...` (the
scripts' own Python, lib/python.sh) runs the offline scripts (OFFLINE) in the scripts'
real environment (FAKE_UV_PYTHON), as the scripts need their answers; anything else
(extra data, the Wikidata cache: they'd go online) only succeeds."""

import json
import os
import sys

args = sys.argv[1:]
with open(os.environ["FAKE_LOG"], "a") as log:
    log.write(json.dumps(["uv", *args]) + "\n")
OFFLINE = ("offline-maps.py", "osm_filter.py")
if args[:1] == ["run"] and "python" in args:
    rest = args[args.index("python") + 1 :]
    if any(arg.endswith(OFFLINE) for arg in rest):
        python = os.environ["FAKE_UV_PYTHON"]
        os.execv(python, [python, *rest])
