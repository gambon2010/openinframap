#!/usr/bin/env python3
"""Stands in for programs the scripts may start (browsers, terminals, uv,
osmium, npm...): logs the call and succeeds."""

import json
import os
import sys

with open(os.environ["FAKE_LOG"], "a") as log:
    log.write(json.dumps([os.path.basename(sys.argv[0]), *sys.argv[1:]]) + "\n")
