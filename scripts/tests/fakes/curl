#!/usr/bin/env python3
"""Fake `curl`: logs calls. URLs on localhost answer when their port is in
FAKE_PORTS_UP (space-separated); everything else fails (no network in tests)."""

import json
import os
import re
import sys

args = sys.argv[1:]
with open(os.environ["FAKE_LOG"], "a") as log:
    log.write(json.dumps(["curl", *args]) + "\n")
for arg in args:
    m = re.match(r"https?://localhost:(\d+)", arg)
    if m:
        sys.exit(0 if m.group(1) in os.environ.get("FAKE_PORTS_UP", "").split() else 7)
sys.exit(6)
